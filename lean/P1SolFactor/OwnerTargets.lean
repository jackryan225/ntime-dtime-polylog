import P1SolFactor.SiteHeader
import P1Benes.Tab
import OAI.Computability.IntegerMultiplication.Code.CodePolyBasic
import OAI.Computability.IntegerMultiplication.Code.Slice

/-!
# P1-sol-factor0: REVISED TARGETS (written by the owner P1-lean-eval, 2026-11-25 13:10Z; do not edit this file)

Decision D13 (G3-chief): the check C13link and the cone program (`WHyp`) are OpenAI `Code.Task`s, so the level-0 factor
is needed in OpenAI's `Poly` calculus, not as a ProgEng register program. The level-0 value is `c * [rnSiteOK ..]`; the
scalar product is done by the caller, so the targets are BOOLEAN:

* `Factor0EntryPoly V a ha`: one `Poly` function from (rule header code, half code) to the decision `rnSiteOK`, for every
  `B, L, I, σ`, every supplied switch settings `bset`, every site `u` and half-assignment `z`. The rule header is the
  prover's own `siteRuleWith` (SiteHeader.lean), coded by `ruleCode` (unary numbers); the half code `halfCode0` is the
  list of out-slot words and the list of in-slot words in slot order (the cone's `P1P5.KW.halfCode`, same definition).
* `CrossPoly`: the Beneš switch bit `P1Benes.Tab.crossT n (tabOf π) (tabOf π.symm) κ a` (= `P1Benes.settings`, by
  `P1Benes.Tab.settings_eq_crossT`) as one `Poly` function of the unary tables and `κ`, `a`.

The witness reading (which rule a position has, from `x` and `u`) is NOT part of these targets (cone side).
-/

namespace P1SolFactor.Owner

open OAI.DepthThreeLowerBound OAI.Computability.IntegerMultiplication OAI.Computability.IntegerMultiplication.Code
open OAI.Computability.VPVNP OAI.Computability.VPVNP.Compression P1Net
open scoped Classical

noncomputable section

/-- Unary code of a site rule (the numbers of `encRule`, as tallies; bits as tally 0 / 1). -/
def ruleCode (V : FiniteMultiTapeMachine) : SiteRule V → List Tally
  | .free => [tally 0]
  | .table B last moves => [tally 1, tally B, tally (if last then 1 else 0)] ++ moves.map fun m => tally m.val
  | .path b c => [tally 2, tally (if b then 1 else 0), tally (if Ext.isIn V c then 1 else 0),
      tally (extIdx V.K c).val]
  | .pins p => tally 3 :: p.map fun s => tally (s.elim 0 fun t => (Fintype.equivFin V.Γ t).val + 1)
  | .copy o i => [tally 4, tally o.val, tally i.val]
  | .route i o => [tally 5, tally (if i then 1 else 0), tally (o.elim 0 fun b => if b then 2 else 1)]
  | .fixed word => tally 6 :: word.map fun b => tally (if b then 1 else 0)

/-- Code of a half-assignment: (out-slot words, in-slot words), slot order (as `P1P5.KW.halfCode`). -/
def halfCode0 {a h : ℕ} (X : State a h) (u : X.Base × BitWord h) (z : X.network.Half u) :
    List (List Bool) × List (List Bool) :=
  (List.ofFn fun k => List.ofFn (z.1 (u, k) rfl),
    List.ofFn fun k => List.ofFn (z.2 (P1Net.inEdge X u k) (P1Net.inEdge_dst X u k)))

/-- **Target 1** (level-0 factor decision, `Poly`). -/
def Factor0EntryPoly (V : FiniteMultiTapeMachine) (a : ℕ) (ha : 4 ≤ 2 ^ a) : Prop :=
  ∃ f : List Tally × (List (List Bool) × List (List Bool)) → Bool, Poly f ∧
    ∀ {g h : ℕ} (B : ℕ) [NeZero B] (L : GuessLayout V g) (I : ℕ) [NeZero I]
      (σ : Fin (I * 2 ^ h) → V.K → Fin 3) (bset : RouteSettings)
      (u : (rnState V B I σ ha).network.Site) (z : (rnState V B I σ ha).network.Half u),
      f (ruleCode V (siteRuleWith V B L I σ ha bset u), halfCode0 (rnState V B I σ ha) u z) =
        decide (rnSiteOK V B L I σ ha bset u z)

/-- **Target 2** (Beneš switch bit, `Poly`). -/
def CrossPoly : Prop :=
  ∃ f : (Tally × (List Tally × List Tally)) × (Tally × Tally) → Bool, Poly f ∧
    ∀ (n : ℕ) (π : Equiv.Perm (Fin (2 ^ (n + 1)))) (κ a : ℕ),
      f ((tally n, ((P1Benes.Tab.tabOf π).map tally, (P1Benes.Tab.tabOf π.symm).map tally)), (tally κ, tally a)) =
        P1Benes.Tab.crossT n (P1Benes.Tab.tabOf π) (P1Benes.Tab.tabOf π.symm) κ a

/-! Small cases (owner checks). -/

example (V : FiniteMultiTapeMachine) : ruleCode V .free = [tally 0] := rfl

example (V : FiniteMultiTapeMachine) (o : Fin 4) (i : Fin 4) :
    ruleCode V (.copy o i) = [tally 4, tally o.val, tally i.val] := rfl

/-- At `n = 0` the switch bit reads only the first table entry. -/
example (π : Equiv.Perm (Fin (2 ^ (0 + 1)))) (a : ℕ) :
    P1Benes.Tab.crossT 0 (P1Benes.Tab.tabOf π) (P1Benes.Tab.tabOf π.symm) 0 a =
      decide ((P1Benes.Tab.tabOf π).getD 0 0 % 2 = 1) := by
  simp [P1Benes.Tab.crossT]

end

end P1SolFactor.Owner
