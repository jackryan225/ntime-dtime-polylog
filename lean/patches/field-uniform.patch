+
+New file (G3-c field-uniform patch). It does not import `MiddleDecision`, so
+its import closure stays near 300 OAI modules: a small build checks the
+characteristic-two statement without the SAT algorithm. -/
+
+namespace OAI.Computability.MultitapeWeakETH
+
+/-- The tape lower bound follows from the Price alternative over any infinite field. -/
+theorem main_of_price_over (k : Type) [Field k] [Infinite k] (price : PriceOver k) :
+    MainStatement :=
+  main_of_tables coarseTraceBound
+    (partialTableBound_of_field (fieldTableBound_of_price_over k price))
+
+/-- The tape lower bound from the absence of ports in characteristic two.
+`Infinite` comes from the Mathlib instance for algebraically closed fields. -/
+theorem main_of_priceTwo (price : PriceTwo) : MainStatement :=
+  main_of_price_over (AlgebraicClosure (ZMod 2)) price
+
+end OAI.Computability.MultitapeWeakETH
